# Postgres connection string (Neon, via the Vercel Marketplace integration).
# Without this, the project falls back to an in-memory preview store that
# resets on every cold start - fine for local dev, not for production.
DATABASE_URL=

# Seeds the waitlist counter so the next real signup continues the sequence
# (e.g. 37 means the next signup becomes #38, then #39, etc).
WAITLIST_INITIAL_COUNT=37

# Resend (https://resend.com) - required to send confirmation and
# referral-jump emails. Without RESEND_API_KEY, email sending is a silent no-op.
RESEND_API_KEY=
# Until a domain is verified with Resend, this must stay on the resend.dev
# sandbox sender (e.g. "TheLingo Placement <onboarding@resend.dev>").
RESEND_FROM_EMAIL="TheLingo Placement <onboarding@resend.dev>"
# Where replies to the confirmation/referral emails should land.
RESEND_REPLY_TO=lingot228@gmail.com

# Canonical site URL, used for referral links, sitemap, robots.txt, and
# Open Graph metadata.
NEXT_PUBLIC_APP_URL=https://thelingo.xyz

# Optional. If set, every signup is also POSTed here (e.g. a Google Sheets
# webhook or Zapier catch hook).
GOOGLE_SHEETS_WEBHOOK_URL=
WEBHOOK_URL=
